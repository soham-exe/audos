{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Audos",
    "version":  "0.1.4",
    "identifier":  "io.github.soham-exe.audos",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Audos",
                                    "width":  900,
                                    "height":  600,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "dragDropEnabled":  false,
                                    "backgroundColor":  "#1a1a1c",
                                    "visible":  false,
                                    "decorations":  true
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "headerImage":  "icons/icon.ico",
                                                "startMenuFolder":  "Audos"
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://github.com/soham-exe/audos/releases/latest/download/latest.json"
                                                  ],
                                    "dialog":  false,
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5MjZDMzVDQ0I2Q0U2MDMKUldRRDVtekxYTU1tS1JPd1BTZFVYTUlaamlldjZHbjZkb1Fka0lpL3RxY0pBbk5NMWxhZVlPWVAK"
                                }
                }
}
